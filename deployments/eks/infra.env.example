# EKS / DNS settings
EKS_CLUSTER_NAME=
AWS_REGION=
ROUTE53_ZONE_NAME=
API_HOST=
GAPI_HOST=
CLUSTER_IAM_ROLE_NAME=

# Managed node group sizing (see scale-nodegroup.sh)
EKS_NODEGROUP_NAME=ytter-nodes-small
EKS_NODE_INSTANCE_TYPE=t3.small
EKS_NODEGROUP_MIN_SIZE=1
EKS_NODEGROUP_MAX_SIZE=1
EKS_NODEGROUP_DESIRED_SIZE=1

# EKS control plane CloudWatch logs (see cluster-logging.sh)
EKS_CLUSTER_LOGGING_ENABLED=false