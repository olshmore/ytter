# ECS / DNS (copy to infra.env)
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=

ECS_CLUSTER_NAME=ytter
ECS_SERVICE_NAME=ytter-api
TASK_FAMILY=ytter-api

ROUTE53_ZONE_NAME=ytter.co.uk
API_HOST=api.ytter.co.uk

ECR_REPOSITORY=ytter

# VPC (defaults filled by bootstrap from EKS cluster if unset)
# VPC_ID=
# SUBNET_IDS=subnet-aaa,subnet-bbb
# RDS_SECURITY_GROUP_IDS=sg-xxx

# Fargate sizing (api + redis sidecar)
FARGATE_CPU=1024
FARGATE_MEMORY=2048
DESIRED_COUNT=1

# Optional: written by bootstrap (deployments/ecs/ecs-state.env)
# ALB_DNS_NAME=
# TARGET_GROUP_ARN=
# ECS_SECURITY_GROUP_ID=
# SECRET_ARN=
